# --- Supabase (public, safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only secret, bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# "ollama" runs against localhost:11434 for local dev.
# Anything else (including unset) uses DeepSeek.
AI_PROVIDER=deepseek
DEEPSEEK_KEY=